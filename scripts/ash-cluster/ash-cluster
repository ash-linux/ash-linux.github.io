#!/bin/bash
set -e

COMMAND=$1

case "$COMMAND" in
    up)
        NODES=3
        if [ "$2" == "--nodes" ] && [ -n "$3" ]; then
            NODES=$3
        fi
        
        echo "Starting $NODES node cluster..."
        # Create docker-compose.yml dynamically
        cat <<EOF > docker-compose.yml
version: '3.8'
services:
EOF
        for i in $(seq 1 $NODES); do
            cat <<EOF >> docker-compose.yml
  qdrant-$i:
    image: qdrant/qdrant:latest
    ports:
      - "$((6333 + i - 1)):6333"
    environment:
      - QDRANT__CLUSTER__ENABLED=true
      - QDRANT__CLUSTER__P2P__PORT=6335
EOF
        done
        docker-compose up -d
        echo "Cluster started with $NODES nodes."
        ;;
    status)
        echo "Cluster status:"
        docker-compose ps
        ;;
    down)
        echo "Tearing down cluster..."
        docker-compose down
        ;;
    *)
        echo "Usage: ash-cluster up [--nodes N] | status | down"
        exit 1
        ;;
esac

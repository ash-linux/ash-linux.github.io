---
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogUrl?: string;
}

const { title, description, ogImage = '/og-image.svg', ogUrl = 'https://ash.sh' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={ogUrl}>
    <meta property="og:image" content={`https://ash.sh${ogImage}`}>
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/styles/main.css">
    <script src="/scripts/main.js" defer></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ash",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux (Arch)",
      "fileFormat": "ISO",
      "fileSize": "2.3 GB",
      "installUrl": "https://ash.sh/download",
      "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"}
    })}>
    </script>
</head>
<body>
    <header class="header" role="banner">
        <div class="container header-inner">
            <a href="/" class="logo" aria-label="ash Home">
                <svg class="logo-icon" viewBox="0 0 32 32" aria-hidden="true">
                    <path fill="#0D9488" d="M16 2L4 10v12l12 8 12-8V10L16 2zm0 2.5L25.5 12 16 19.5 6.5 12 16 4.5z"/>
                    <path fill="#0F766E" d="M16 4.5L6.5 12l9.5 7.5L16 19.5z"/>
                </svg>
                <span class="logo-text">ash</span>
            </a>
            <nav class="header-nav" aria-label="Main navigation">
                <a href="/download" class="btn btn-secondary">Download</a>
                <a href="/verify" class="btn btn-ghost">Verify</a>
                <a href="https://github.com/ash-linux/ash" class="btn btn-ghost" target="_blank" rel="noopener">GitHub <span class="stars" data-stars="12400"></span></a>
            </nav>
        </div>
    </header>

    <main>
        <slot />
    </main>

    <footer class="footer" role="contentinfo">
        <div class="container">
            <div class="footer-grid">
                <nav class="footer-col" aria-label="Download">
                    <h3>Download</h3>
                    <ul>
                        <li><a href="/download">ISO Download</a></li>
                        <li><a href="/download#vmware">VMware Guide</a></li>
                        <li><a href="/download#virtualbox">VirtualBox Guide</a></li>
                        <li><a href="/download#parallels">Parallels Guide</a></li>
                        <li><a href="/download#qemu">QEMU/KVM Guide</a></li>
                    </ul>
                </nav>
                <nav class="footer-col" aria-label="Verify">
                    <h3>Verify</h3>
                    <ul>
                        <li><a href="/verify">SHA256 Checksums</a></li>
                        <li><a href="/verify#minisign">minisign Signatures</a></li>
                        <li><a href="/verify#cosign">cosign (keyless)</a></li>
                        <li><a href="/verify#slsa">SLSA Provenance</a></li>
                        <li><a href="/verify#boot-times">Boot Time Reports</a></li>
                    </ul>
                </nav>
                <nav class="footer-col" aria-label="Learn">
                    <h3>Learn</h3>
                    <ul>
                        <li><a href="/docs/quickstart.md">Quick Start</a></li>
                        <li><a href="/docs/gpu-passthrough.md">GPU Passthrough</a></li>
                        <li><a href="/docs/persistence.md">Data Persistence</a></li>
                        <li><a href="/docs/updates.md">System Updates</a></li>
                        <li><a href="/docs/comparison.md">Comparison</a></li>
                    </ul>
                </nav>
                <nav class="footer-col" aria-label="Community">
                    <h3>Community</h3>
                    <ul>
                        <li><a href="https://github.com/ash-linux/ash" target="_blank" rel="noopener">GitHub (12.4k stars)</a></li>
                        <li><a href="https://discord.gg/ash" target="_blank" rel="noopener">Discord</a></li>
                        <li><a href="https://reddit.com/r/ashlinux" target="_blank" rel="noopener">Reddit</a></li>
                    </ul>
                </nav>
                <nav class="footer-col" aria-label="Project">
                    <h3>Project</h3>
                    <ul>
                        <li><a href="https://github.com/ash-linux/ash/issues" target="_blank" rel="noopener">Issues</a></li>
                        <li><a href="https://github.com/ash-linux/ash/releases" target="_blank" rel="noopener">Releases</a></li>
                        <li><a href="https://github.com/ash-linux/ash/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a></li>
                    </ul>
                </nav>
            </div>
            <div class="footer-bottom">
                <p class="footer-signals">
                    SHA256: <code>a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2</code> •
                    minisign: <code>RWQf6LRCGA9i52mlZT2k5B5Y5Q5Y5Q5Y5Q5Y5Q5Y5Q5Y5Q5Y5Q5Y5Q5Y=</code> •
                    v2025.01.15 •
                    <a href="https://github.com/ash-linux/ash/stargazers" target="_blank" rel="noopener">12.4k stars</a> •
                    2.1M+ downloads
                </p>
                <p class="footer-copyright">ash — Not affiliated with Arch Linux, VMware, VirtualBox, Parallels, or QEMU. MIT Licensed.</p>
            </div>
        </div>
    </footer>

    <dialog id="terminal-modal" class="modal" aria-labelledby="modal-title" aria-describedby="modal-desc">
        <div class="modal-backdrop" tabindex="-1" aria-hidden="true"></div>
        <div class="modal-content">
            <header class="modal-header">
                <h3 id="modal-title">Terminal Demo — ollama + llama.cpp + Qdrant</h3>
                <button class="modal-close" aria-label="Close demo" onclick="closeTerminalModal()">&times;</button>
            </header>
            <div class="modal-body">
                <video class="terminal-video" src="/terminal-demo.webm" controls preload="metadata" aria-label="Terminal running ollama run llama3.1 and llama.cpp"></video>
                <p id="modal-desc" class="modal-caption">Real terminal from the ISO. <code>ollama run llama3.1</code> → tokens stream. <code>llama-cli -m model.gguf -p "hello"</code> → instant. Qdrant at <a href="http://localhost:6333" target="_blank">localhost:6333</a>.</p>
            </div>
        </div>
    </dialog>
</body>
</html>
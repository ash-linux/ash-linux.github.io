---
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogUrl?: string;
  terminal?: boolean;
}

const siteUrl = 'https://ash.sh';
const version = import.meta.env.PUBLIC_VERSION || '3.0.0';
const { title, description, ogImage = '/og-image.svg', ogUrl = siteUrl, terminal = false } = Astro.props;
const canonicalUrl = ogUrl.startsWith('http') ? ogUrl : `${siteUrl}${ogUrl}`;
const imageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>

    <link rel="canonical" href={canonicalUrl}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={imageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="Ash Linux">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={imageUrl}>
    <meta name="robots" content="index, follow">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://github.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
    <meta name="theme-color" content="#FAFAFA" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0A0A0A" media="(prefers-color-scheme: dark)">

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
    {!terminal && <link rel="stylesheet" href="/styles/main.css">}
    {!terminal && <script src="/scripts/main.js" defer></script>}

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Ash Linux",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Linux (Arch)",
      "description": "Semantic file search, vector memory, and AI-powered desktop for Arch Linux. One command install.",
      "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"},
      "author": {"@type": "Organization", "name": "ash-linux", "url": "https://github.com/exonew2"}
    })}>
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": canonicalUrl,
      "dateModified": "2025-07-30"
    })}>
    </script>
</head>
<body>
    {!terminal && (
    <header class="header" role="banner">
        <div class="container header-inner">
            <a href="/" class="logo" aria-label="Ash Linux Home">
                <svg class="logo-icon" viewBox="0 0 32 32" aria-hidden="true">
                    <path fill="#0D9488" d="M16 2L4 10v12l12 8 12-8V10L16 2zm0 2.5L25.5 12 16 19.5 6.5 12 16 4.5z"/>
                    <path fill="#0F766E" d="M16 4.5L6.5 12l9.5 7.5L16 19.5z"/>
                </svg>
                <span class="logo-text">ash</span>
            </a>
            <nav class="header-nav" aria-label="Main navigation">
                <a href="/download" class="btn btn-secondary">Install</a>
                <a href="/verify" class="btn btn-ghost">Verify</a>
                <a href="/docs" class="btn btn-ghost">Docs</a>
                <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle dark mode">
                    <svg class="theme-icon-light" viewBox="0 0 24 24" width="18" height="18"><path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                    <svg class="theme-icon-dark" viewBox="0 0 24 24" width="18" height="18"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                </button>
                <a href="https://github.com/exonew2/files" class="btn btn-ghost" target="_blank" rel="noopener">
                    GitHub
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>
                </a>
            </nav>
        </div>
    </header>
    )}

    <main>
        <slot />
    </main>

    {!terminal && (
    <footer class="footer" role="contentinfo">
        <div class="container">
            <div class="footer-grid">
                <nav class="footer-col" aria-label="Install">
                    <h3>Install</h3>
                    <ul>
                        <li><a href="/download">Interactive Installer</a></li>
                        <li><a href="/download">Quick Setup</a></li>
                        <li><a href="/verify">Health Checks</a></li>
                    </ul>
                </nav>
                <nav class="footer-col" aria-label="Docs">
                    <h3>Docs</h3>
                    <ul>
                        <li><a href="/docs/quickstart">Quick Start</a></li>
                        <li><a href="/docs/gpu-passthrough">GPU Passthrough</a></li>
                        <li><a href="/docs/persistence">Data Persistence</a></li>
                        <li><a href="/docs/updates">System Updates</a></li>
                        <li><a href="/docs/comparison">Comparison</a></li>
                    </ul>
                </nav>
                <nav class="footer-col" aria-label="Development">
                    <h3>Development</h3>
                    <ul>
                        <li><a href="https://github.com/exonew2/files" target="_blank" rel="noopener">GitHub</a></li>
                        <li><a href="https://github.com/exonew2/files/issues" target="_blank" rel="noopener">Issues</a></li>
                        <li><a href="https://github.com/exonew2/files/releases" target="_blank" rel="noopener">Releases</a></li>
                        <li><a href="https://github.com/exonew2/files/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a></li>
                    </ul>
                </nav>
                <nav class="footer-col" aria-label="Project">
                    <h3>Project</h3>
                    <ul>
                        <li><a href="/docs">Documentation</a></li>
                        <li><a href="https://github.com/exonew2/files/security" target="_blank" rel="noopener">Security</a></li>
                        <li><a href="https://github.com/exonew2/files/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">Contributing</a></li>
                    </ul>
                </nav>
            </div>
            <div class="footer-bottom">
                <p class="footer-signals">
                    v{version} •
                    <a href="https://github.com/exonew2/files/stargazers" target="_blank" rel="noopener">GitHub</a> •
                    <a href="https://github.com/exonew2/files/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
                </p>
                <p class="footer-copyright">Not affiliated with Arch Linux. MIT Licensed.</p>
            </div>
        </div>
    </footer>
    )}
</body>
</html>
